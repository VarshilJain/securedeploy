# Version Control
.git/
.github/
.gitignore

# Python virtual environments & caches
venv/
.venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
tests/

# Security reports and local artifacts
reports/
*.log
*.zip
*.tar
*.gz

# Documentation & Demo files (not needed in container runtime)
*.md
demo/
docs/
scripts/

# Local configuration & credentials
.env
.env.*
*.pem
*.key
*.crt
